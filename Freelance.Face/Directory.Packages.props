<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Shared building blocks (GitHub package feed) -->
    <PackageVersion Include="Freelance.Shared.Events" Version="1.1.0" />
    <PackageVersion Include="Shared.Api" Version="1.1.9" />
    <!-- Third party -->
    <PackageVersion Include="DlibDotNet" Version="19.21.0.20220724" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.15" />
    <PackageVersion Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
    <!-- WolverineFx 6 no longer ships the Roslyn runtime compiler used by TypeLoadMode.Dynamic. -->
    <PackageVersion Include="WolverineFx.RuntimeCompilation" Version="6.65.1" />
    <!-- Pinned: DlibDotNet depends on System.Drawing.Common 5.0.1 (GHSA-rxg9-xrhp-64gj, critical). -->
    <PackageVersion Include="System.Drawing.Common" Version="10.0.15" />
    <PackageVersion Include="System.Numerics.Tensors" Version="10.0.15" />
  </ItemGroup>
</Project>
