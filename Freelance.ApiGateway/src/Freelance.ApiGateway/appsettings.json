{
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000", "https://yourfrontend.com" ]
  },
  "JwtSettings": {
    "Key": "YourSuperSecretKeyHere123!ChangeItTo32PlusChars",
    "Issuer": "FreelanceApp",
    "Audience": "FreelanceAppUsers"
  },
  "Routes": [
    {
      "DownstreamPathTemplate": "/auth/register",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "freelance_identity",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/auth/register",
      "UpstreamHttpMethod": [
        "POST"
      ],
      "SwaggerKey": "auth"
    },
    {
      "DownstreamPathTemplate": "/auth/login",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "freelance_identity",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/auth/login",
      "UpstreamHttpMethod": [
        "POST"
      ],
      "SwaggerKey": "auth"
    },
    {
      "DownstreamPathTemplate": "/auth/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "freelance_identity",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/auth/{everything}",
      "UpstreamHttpMethod": [
        "GET",
        "PUT",
        "DELETE"
      ],
      "AuthenticationOptions": {
        "AuthenticationProviderKeys": [ "Bearer" ]
      },
      "SwaggerKey": "auth"
    },
    {
      "DownstreamPathTemplate": "/client-profiles/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "freelance_user_profiles",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/client-profiles/{everything}",
      "UpstreamHttpMethod": [
        "GET",
        "POST",
        "PUT",
        "DELETE"
      ],
      "AuthenticationOptions": {
        "AuthenticationProviderKeys": [ "Bearer" ]
      },
      "SwaggerKey": "profiles"
    },
    {
      "DownstreamPathTemplate": "/freelancer-profiles/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "freelance_user_profiles",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/freelancer-profiles/{everything}",
      "UpstreamHttpMethod": [
        "GET",
        "POST",
        "PUT",
        "DELETE"
      ],
      "AuthenticationOptions": {
        "AuthenticationProviderKeys": [ "Bearer" ]
      },
      "SwaggerKey": "profiles"
    },
    {
      "DownstreamPathTemplate": "/camera/capture/sessions",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "freelance_face",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/camera/capture/sessions",
      "UpstreamHttpMethod": [
        "POST"
      ],
      "SwaggerKey": "face"
    },
    {
      "DownstreamPathTemplate": "/project/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "freelance_project_management",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/project/{everything}",
      "UpstreamHttpMethod": [
        "GET",
        "POST",
        "PUT",
        "DELETE"
      ],
      "AuthenticationOptions": {
        "AuthenticationProviderKeys": [ "Bearer" ]
      },
      "SwaggerKey": "projects"
    },
    {
      "DownstreamPathTemplate": "/projectTask/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "freelance_project_management",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/projectTask/{everything}",
      "UpstreamHttpMethod": [
        "GET",
        "POST",
        "PUT",
        "DELETE"
      ],
      "AuthenticationOptions": {
        "AuthenticationProviderKeys": [ "Bearer" ]
      },
      "SwaggerKey": "projects"
    },
    {
      "DownstreamPathTemplate": "/timeLog/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "freelance_project_management",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/timeLog/{everything}",
      "UpstreamHttpMethod": [
        "GET",
        "POST",
        "PUT",
        "DELETE"
      ],
      "AuthenticationOptions": {
        "AuthenticationProviderKeys": [ "Bearer" ]
      },
      "SwaggerKey": "projects"
    }
  ],
  "GlobalConfiguration": {
    "BaseUrl": "http://localhost:9000"
  },
  "SwaggerEndPoints": [
    {
      "Key": "auth",
      "Config": [
        {
          "Name": "Auth API",
          "Version": "v1",
          "Url": "http://freelance_identity:8080/openapi/v1.json"
        }
      ]
    },
    {
      "Key": "profiles",
      "Config": [
        {
          "Name": "User Profiles API",
          "Version": "v1",
          "Url": "http://freelance_user_profiles:8080/openapi/v1.json"
        }
      ]
    },
    {
      "Key": "face",
      "Config": [
        {
          "Name": "Face API",
          "Version": "v1",
          "Url": "http://freelance_face:8080/openapi/v1.json"
        }
      ]
    },
    {
      "Key": "projects",
      "Config": [
        {
          "Name": "Project Management API",
          "Version": "v1",
          "Url": "http://freelance_project_management:8080/openapi/v1.json"
        }
      ]
    }
  ]
}