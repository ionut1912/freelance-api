{
  "JwtSettings": {
    "Key": "YourSuperSecretKeyHere123!ChangeItTo32PlusChars",
    "Issuer": "FreelanceApp",
    "Audience": "FreelanceAppUsers"
  },
  "Routes": [
    {
      "DownstreamPathTemplate": "/api/auth/register",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "freelance_identity",
          "Port": 80
        }
      ],
      "UpstreamPathTemplate": "/auth/register",
      "UpstreamHttpMethod": [
        "POST"
      ],
      "SwaggerKey": "auth"
    },
    {
      "DownstreamPathTemplate": "/api/auth/login",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "freelance_identity",
          "Port": 80
        }
      ],
      "UpstreamPathTemplate": "/auth/login",
      "UpstreamHttpMethod": [
        "POST"
      ],
      "SwaggerKey": "auth"
    },
    {
      "DownstreamPathTemplate": "/api/auth/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "freelance_identity",
          "Port": 80
        }
      ],
      "UpstreamPathTemplate": "/auth/{everything}",
      "UpstreamHttpMethod": [
        "GET",
        "PUT",
        "DELETE"
      ],
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer"
      },
      "SwaggerKey": "auth"
    },
    {
      "DownstreamPathTemplate": "/api/client-profiles/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "freelance_user_profiles",
          "Port": 80
        }
      ],
      "UpstreamPathTemplate": "/client-profiles/{everything}",
      "UpstreamHttpMethod": [
        "GET",
        "POST",
        "PUT",
        "DELETE"
      ],
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer"
      },
      "SwaggerKey": "client-profiles"
    },
    {
      "DownstreamPathTemplate": "/api/freelancer-profiles/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "freelance_user_profiles",
          "Port": 80
        }
      ],
      "UpstreamPathTemplate": "/freelancer-profiles/{everything}",
      "UpstreamHttpMethod": [
        "GET",
        "POST",
        "PUT",
        "DELETE"
      ],
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer"
      },
      "SwaggerKey": "freelancer-profiles"
    }
  ],
  "GlobalConfiguration": {
    "BaseUrl": "http://gateway"
  },
  "SwaggerEndPoints": [
    {
      "Key": "auth",
      "Config": [
        {
          "Name": "Auth API",
          "Version": "v1",
          "Url": "http://freelance_identity/swagger/v1/swagger.json"
        }
      ]
    },
    {
      "Key": "client-profiles",
      "Config": [
        {
          "Name": "Client Profiles API",
          "Version": "v1",
          "Url": "http://freelance_user_profiles/swagger/v1/swagger.json"
        }
      ]
    },
    {
      "Key": "freelancer-profiles",
      "Config": [
        {
          "Name": "Freelancer Profiles API",
          "Version": "v1",
          "Url": "http://freelance_user_profiles/swagger/v1/swagger.json"
        }
      ]
    }
  ]
}