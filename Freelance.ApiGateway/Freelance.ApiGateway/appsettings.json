{
  "JwtSettings": {
    "Key": "YourSuperSecretKeyHere123!ChangeItTo32PlusChars",
    "Issuer": "FreelanceApp",
    "Audience": "FreelanceAppUsers"
  },
  "Routes": [
    {
      "DownstreamPathTemplate": "/api/auth/{everything}",
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [{ "Host": "localhost", "Port": 7016 }],
      "UpstreamPathTemplate": "/auth/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST", "PUT", "DELETE" ],
      "AuthenticationOptions": { "AuthenticationProviderKey": "Bearer" },
      "SwaggerKey": "auth"
    },
    {
      "DownstreamPathTemplate": "/api/client-profiles/{everything}",
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [{ "Host": "localhost", "Port": 7125 }],
      "UpstreamPathTemplate": "/client-profiles/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST", "PUT", "DELETE" ],
      "AuthenticationOptions": { "AuthenticationProviderKey": "Bearer" },
      "SwaggerKey": "client-profiles"
    },
    {
      "DownstreamPathTemplate": "/api/freelancer-profiles/{everything}",
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [{ "Host": "localhost", "Port": 7125 }],
      "UpstreamPathTemplate": "/freelancer-profiles/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST", "PUT", "DELETE" ],
      "AuthenticationOptions": { "AuthenticationProviderKey": "Bearer" },
      "SwaggerKey": "freelancer-profiles"
    }
  ],
  "GlobalConfiguration": { "BaseUrl": "https://localhost:7040" },
  "SwaggerEndPoints": [
    {
      "Key": "auth",
      "Config": [
        { "Name": "Auth API", "Version": "v1", "Url": "https://localhost:7016/swagger/v1/swagger.json" }
      ]
    },
    {
      "Key": "client-profiles",
      "Config": [
        { "Name": "Client Profiles API", "Version": "v1", "Url": "https://localhost:7125/swagger/v1/swagger.json" }
      ]
    },
    {
      "Key": "freelancer-profiles",
      "Config": [
        { "Name": "Freelancer Profiles API", "Version": "v1", "Url": "https://localhost:7125/swagger/v1/swagger.json" }
      ]
    }
  ]
}