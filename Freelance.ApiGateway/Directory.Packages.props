<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Shared building blocks (GitHub package feed) -->
    <PackageVersion Include="Shared.Api" Version="1.1.9" />
    <!-- Third party -->
    <PackageVersion Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
    <PackageVersion Include="Ocelot" Version="25.0.3" />
  </ItemGroup>
</Project>
