<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="github" value="https://nuget.pkg.github.com/ionut1912/index.json" />
  </packageSources>
  <!-- The token is read from the NUGET_AUTH_TOKEN environment variable / Docker build arg; never commit a real token. -->
  <packageSourceCredentials>
    <github>
      <add key="Username" value="ionut1912" />
      <add key="ClearTextPassword" value="%NUGET_AUTH_TOKEN%" />
    </github>
  </packageSourceCredentials>
  <!-- Source mapping prevents dependency-confusion attacks: private packages only ever come from the GitHub feed. -->
  <packageSourceMapping>
    <packageSource key="github">
      <package pattern="Shared.*" />
      <package pattern="Freelance.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
