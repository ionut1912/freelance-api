<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Shared building blocks (GitHub package feed) -->
    <PackageVersion Include="Shared.Api" Version="1.1.9" />
    <PackageVersion Include="Shared.Domain" Version="1.1.1" />
    <PackageVersion Include="Shared.Infra" Version="1.1.3" />
    <!-- Third party -->
    <PackageVersion Include="BCrypt.Net-Next" Version="4.2.0" />
    <PackageVersion Include="FluentValidation" Version="12.2.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.15" />
    <PackageVersion Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.23.0" />
    <PackageVersion Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
    <!-- WolverineFx 6 no longer ships the Roslyn runtime compiler used by TypeLoadMode.Dynamic. -->
    <PackageVersion Include="WolverineFx.RuntimeCompilation" Version="6.65.1" />
  </ItemGroup>
</Project>
